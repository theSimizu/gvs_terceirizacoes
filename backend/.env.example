# Copie para .env e preencha os segredos antes de usar Docker Compose.
# PORT e a porta publicada no computador; a API no container usa 8080.
PORT=8080
MYSQL_DATABASE=gvs_terceirizacoes
DB_USERNAME=gvs_app
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=

# Bootstrap opcional: use um email novo e remova os valores apos criar o ADM.
GVS_ADMIN_EMAIL=
GVS_ADMIN_PASSWORD=
GVS_ADMIN_NAME=Administrador GVS

# Apenas para executar Maven fora do Docker; o Compose monta sua URL interna.
DB_URL=jdbc:mysql://localhost:3306/gvs_terceirizacoes
